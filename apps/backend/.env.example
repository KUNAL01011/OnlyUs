# ───────────────────────────── Only Us · Backend ─────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS + Socket.IO)
# In production set this to your Vercel URL, e.g. https://only-us.vercel.app
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Atlas connection string
MONGODB_URI=ljsofejwofiwfj

# The shared private access code that both people use to enter the space.
# Person A gives this to Person B. Keep it secret.
ACCESS_CODE=1234

# Secret used to sign the session JWT stored in the httpOnly cookie.
# Generate a long random string for production.
JWT_SECRET=change-me-to-a-very-long-random-secret

# How long a session stays valid.
SESSION_TTL=7d

# Fixed identifier of the single private room. You never need to change this.
ROOM_ID=only-us

# ───────────────────────────── Keep-alive (Render) ───────────────────────────
# Render's free web services sleep after ~15 min of no traffic. The backend runs
# an internal node-cron job that pings PUBLIC_URL every KEEPALIVE_MINUTES.
# Set PUBLIC_URL to the backend's own public Render URL in production.
PUBLIC_URL=http://localhost:4000
KEEPALIVE_MINUTES=10
KEEPALIVE_ENABLED=true
