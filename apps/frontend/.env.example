# ──────────────────────────── Only Us · Frontend ────────────────────────────

# Base URL of the Node backend (Render in production).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Socket.IO endpoint — usually the same origin as the API.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ───────────────────────────── WebRTC ICE servers ────────────────────────────
# STUN is enough for development. For production add a TURN relay so calls work
# behind strict NATs / firewalls. Multiple STUN urls can be comma-separated.
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN (leave blank in dev). Example values shown.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# ───────────────────────────── GIF search (optional) ─────────────────────────
# Uses the Giphy API. Without a key the GIF picker falls back to Giphy's public
# beta key so it still works out of the box.
NEXT_PUBLIC_GIPHY_KEY=
